# /etc/family-budget/env
# Владелец root, права 600: chmod 600 /etc/family-budget/env

# --- База данных (нативный PostgreSQL на 127.0.0.1) ---
DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/family_budget
DATASOURCE_USERNAME=family_budget
DATASOURCE_PASSWORD=CHANGE_ME

# --- JWT ---
# Сгенерировать: openssl rand -base64 48
# Обязательно свой, не dev-значение из application.yml.
JWT_SECRET=CHANGE_ME

# --- CORS ---
# Для same-origin SPA не нужен, но можно разрешить прод-домен.
CORS_ALLOWED_ORIGINS=https://mishapp.ru,https://www.mishapp.ru
